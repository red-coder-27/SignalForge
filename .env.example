# SignalForge Environment Configuration
# Copy this file to .env.local and add your secret SerpApi key.
# IMPORTANT: Never commit .env.local or your real API key to version control!

# SerpApi API key (from https://serpapi.com/manage-api-key)
SERPAPI_KEY=your_serpapi_api_key_here

# Optional: Default Search Engine Region / Locale
SERPAPI_GL=us
SERPAPI_HL=en

# Optional: Mock AI Provider (Deterministic, no external key needed by default)
# AI Provider is 100% optional per hackathon guidelines. SignalForge runs entirely on deterministic decision rules.
ENABLE_AI_ASSISTANT=false
